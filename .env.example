# Bu dosyanın bir kopyasını ".env" adıyla oluştur ve değerleri doldur.
# .env dosyası gizlidir, asla paylaşma ve GitHub'a yükleme.

# --- Zorunlu ---
# BotFather'dan aldığın token (örnek: 123456789:ABCdef...)
TELEGRAM_BOT_TOKEN=
# Bildirimlerin gideceği grup/kanal ID'si (grup için genelde -100 ile başlar)
TELEGRAM_CHAT_ID=
# Google Cloud Console'dan aldığın YouTube Data API v3 anahtarı
YOUTUBE_API_KEY=
# Takip edilecek kanalın ID'si (UC ile başlar, 24 karakter)
YOUTUBE_CHANNEL_ID=

# --- İsteğe bağlı ---
# Test modunda mesajın gideceği sohbet (örneğin botla kendi özel sohbetin).
# Boş bırakırsan test mesajı da TELEGRAM_CHAT_ID'ye gider.
TELEGRAM_TEST_CHAT_ID=

# Kaç dakikada bir kontrol edilsin (sadece bilgisayarda sürekli çalışırken geçerli;
# GitHub Actions'ta aralığı .github/workflows/youtube-bot.yml belirler)
KONTROL_ARALIGI_DAKIKA=3

# Planlanmış yayın için "📅 Yayın planlandı" mesajı gönderilsin mi? (evet/hayır)
PLANLI_YAYIN_BILDIRIMI=evet

# Shorts videoları bildirilsin mi? (evet/hayır)
SHORTS_BILDIRIMI=hayir
